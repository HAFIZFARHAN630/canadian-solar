# ============================================================
# Canadian Solar Module Authenticity — Environment Variables
# ============================================================
# Copy this file to `.env` on the server and adjust values.
# Never commit the real .env file.

# ------------------------------------------------------------
# DATABASE_URL
# ------------------------------------------------------------
# Prisma SQLite connection string.
# Use an ABSOLUTE path on the server so the DB lives outside
# the web root (recommended for cPanel shared hosting).
#
# Example for cPanel:
#   DATABASE_URL=file:/home/USERNAME/canadian-solar/db/custom.db
#
# The directory must exist and be writable by the Node process.
DATABASE_URL=file:./db/custom.db

# ------------------------------------------------------------
# NEXTAUTH_SECRET
# ------------------------------------------------------------
# Required by next-auth. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string

# ------------------------------------------------------------
# NEXTAUTH_URL
# ------------------------------------------------------------
# The public URL of the deployed app.
# Example for cPanel: https://canadian-solar.example.com
NEXTAUTH_URL=http://localhost:3000

# ------------------------------------------------------------
# NODE_ENV
# ------------------------------------------------------------
# Set to "production" on the server.
NODE_ENV=production

# ------------------------------------------------------------
# PORT  (cPanel sets this automatically — leave commented)
# ------------------------------------------------------------
# PORT=3000

# ------------------------------------------------------------
# HOSTNAME  (default 0.0.0.0 is fine for cPanel Passenger)
# ------------------------------------------------------------
# HOSTNAME=0.0.0.0
